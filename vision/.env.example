# Copy to .env and fill in. NEVER commit the real .env.
#
# LAN-ONLY SERVICE (D-V1): the sidecar is unauthenticated in v1, like the
# Playwright MCP. Bind it — and the minio it fronts — to trusted interfaces
# only; never expose either to the public internet.

# Sync driver REQUIRED — postgresql+psycopg://  (NOT +asyncpg; the sidecar is
# threadpool-sync). Same Postgres the backend/agent use; needs pgvector.
DATABASE_URL="postgresql+psycopg://snagr:CHANGE_ME@192.168.0.112:5432/snagr"

# Object store — any S3-compatible endpoint. The compose vision profile ships
# a minio whose root credentials must match these (see docker-compose.yml).
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="snagr-vision"
S3_ACCESS_KEY="snagr-minio"
S3_SECRET_KEY="CHANGE_ME"

# DINOv3 weights are gated under Meta's license and can't ship with Snagr:
# accept the license at https://huggingface.co/facebook/dinov3-vits16plus-pretrain-lvd1689m
# create a token at https://huggingface.co/settings/tokens, and set it here.
# The first start downloads the weights; without a token the service runs
# degraded (no scoring) and says so on /health.
HF_TOKEN=""
# Must embed at dim 384 (the schema's vector width) — the default does.
#VISION_MODEL="facebook/dinov3-vits16plus-pretrain-lvd1689m"

# Unreviewed listing captures are pruned after this many days (D-V12)
VISION_RETENTION_DAYS=90

PORT=8100
