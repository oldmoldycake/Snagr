# Copy to .env and fill in. NEVER commit the real .env.

# Async driver is REQUIRED — postgresql+asyncpg://  (NOT plain postgresql://)
DATABASE_URL="postgresql+asyncpg://snagr:CHANGE_ME@192.168.0.112:5432/snagr"

# Auth — generate a secret:  python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET="CHANGE_ME"
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30
COOKIE_SECURE=false        # set true in production (HTTPS only)

# Instance / notifications
APP_VERSION="0.1.0"
NTFY_SERVER_URL=""         # empty -> InstanceInfo.ntfy_server_url is null

# Registration toggle: true = anyone can self-register; false = invite-only
# (the very first user can always register and becomes admin)
REGISTRATION_OPEN=false

# SSO via OIDC (e.g. Authentik) — all three required to enable; leave unset to disable.
# Register the redirect URL  https://<public-host>/api/auth/oidc/callback  at the IdP.
#OIDC_ISSUER=https://auth.example.com/application/o/snagr/
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_PROVIDER_NAME=Authentik
# Only needed when a proxy hides the public host from the backend:
#OIDC_REDIRECT_URI=
