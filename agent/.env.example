# AI provider config (used by config.py -> init_chat_model)
# Provider must match a langchain init_chat_model provider key,
# e.g. openrouter, openai, anthropic, ollama, groq, mistralai, etc.
AI_PROVIDER="openrouter"
AI_API_KEY="your-api-key-here"
AI_MODEL="minimax/minimax-m3"
AI_URL="https://openrouter.ai/api/v1"



#Monitoring

#If using langfuse
LANGFUSE_SECRET_KEY="your-secret-key-here"
LANGFUSE_PUBLIC_KEY="your-public-key-here"
LANGFUSE_BASE_URL="YOUR-URL-HERE"

#If using langsmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY="your-api-key-here"
LANGSMITH_PROJECT="your-project-name"
# MCP — a containerized agent needs a container-reachable host here
# (e.g. the MCP container's name on a shared docker network), not localhost.
# The server must run with --isolated: the hunter opens one browser context
# per job, and a server on a persistent profile refuses the second one.
PLAYWRIGHT_MCP_URL="http://localhost:8931/mcp"

# Visual authenticity: the vision sidecar's URL. Unset = the feature is off
# (the check_images tool is not registered; scraping runs exactly as before).
#VISION_SIDECAR_URL="http://localhost:8100"
#VISION_TIMEOUT_SECONDS=90

# DATABASE
DATABASE_URL="postgresql+asyncpg://user:password@host:5432/dbname"

# NOTIFICATIONS. Always on and needing no delivery config here: the agent
# only queues notification_outbox rows in Postgres — the backend's dispatcher
# delivers them to the channels each user configures under Settings (ntfy,
# Discord, signed webhook; the ntfy server URL lives in backend/.env only).
# A watch is announced when its best price CROSSES its target, so a listing
# that merely stays cheap is not re-announced every run. This is the extra
# spam floor on top of that, for a price that flaps across the target.
# (Renamed from NTFY_COOLDOWN_HOURS when delivery moved to the backend.)
#NOTIFY_COOLDOWN_HOURS=24

# SEARCH (market-price grounding). Where grounding finds price-guide pages and
# price snippets — pick one:
#   searxng  your own SearXNG instance (JSON output format enabled). Free, and
#            nothing leaves your network, but it is one more service to run.
#   brave    the Brave Search API: a key instead of a service. Billed per
#            query after a small monthly allowance, and your item names are
#            sent to Brave. About 7–10 queries per item per refresh.
#   none     no search. Items keep refreshing from guide pages they already
#            found; new items get no market price. Hunting is unaffected.
# Unset, SEARCH_PROVIDER is searxng when SEAR_XNG_URL is set and none otherwise.
# A choice missing its URL or key stops the agent at startup.
#SEARCH_PROVIDER=searxng
SEAR_XNG_URL="http://localhost:8888"
#BRAVE_API_KEY="your-brave-search-api-key"
# The only currency grounding stats are built from (USD, EUR, GBP).
# Other currencies are recorded but never mixed in - no conversion.
EXPECTED_CURRENCY="USD"
# Market stats refresh when older than the TTL, at most MAX_REFRESH items per
# pass (never-grounded items are exempt from the cap).
#
# The hunter is normally a daemon — `main.py --serve`, which is what the
# docker-compose `agent` service runs. For a machine that should not hold a
# process open, `main.py --once` queues what is due, drains the queue and
# exits; cron it as often as you want work to start:
#   */5 * * * *  main.py --once
MARKET_PRICE_TTL_HOURS=24
MARKET_PRICE_MAX_REFRESH_PER_RUN=10

# THE WORK QUEUE (all optional). RECHECK_INTERVAL_MINUTES is the whole recheck
# cadence: a finished check queues the next one that far ahead. The two pools
# are sized separately because they cost different things — checks are cheap
# and mostly browserless, hunts carry the model (grounding runs in the hunt
# pool, being model work too). Raise HUNT_CONCURRENCY only after measuring
# what your provider will take; a local model usually wants to stay at 1.
#
# A watch can set its own interval on the item form; null there means
# RECHECK_INTERVAL_MINUTES, and RECHECK_INTERVAL_FLOOR_MINUTES is the least any
# watch gets. Both must match the values in backend/.env — the two components
# do not share a file, the UI reads the default from the backend, and the
# backend refuses an interval below the floor.
#RECHECK_INTERVAL_MINUTES=30
#RECHECK_INTERVAL_FLOOR_MINUTES=5
#RECHECK_CONCURRENCY=3
#HUNT_CONCURRENCY=1

# PERPETUAL HUNTING (all optional). A watch with open slots is hunted on its
# own, and one whose slots are all filled is not hunted at all until a listing
# sells, ends or is untracked. A hunt that saves nothing queues the next one
# BACKOFF_MIN minutes out, doubling each time it comes back empty up to
# BACKOFF_CAP; a save, a freed slot or a "hunt now" starts it over. A watch can
# switch this off for itself on the item form (then it is hunted only when you
# press Hunt now).
#
# HUNT_ENABLED=false is the panic button: nothing is hunted at all — no
# sweep, no follow-up hunts, and queued ones wait — while prices are still
# rechecked. Set the SAME value in backend/.env, which refuses "hunt now" with
# it off and shows "hunting paused by the operator" in the UI.
#HUNT_ENABLED=true
#HUNT_BACKOFF_MIN_MINUTES=15
#HUNT_BACKOFF_CAP_MINUTES=360

# JOB LIFECYCLE (all optional). A running job stamps a heartbeat every
# HEARTBEAT_INTERVAL seconds; one silent for longer than STALE_AFTER is taken
# back by the reaper, because a crashed worker would otherwise hold its
# target's queue slot forever. A job that has burned MAX_ATTEMPTS is failed
# for good. Terminal rows are swept on the retention clocks: a check is a
# heartbeat (the price history lives in price_checks), a hunt is a story.
# Each unit of work is capped at MAX_STEPS graph steps (~2 per tool call) and
# UNIT_TIMEOUT seconds; tripping either fails that job and the queue moves on.
#JOB_HEARTBEAT_INTERVAL_SECONDS=30
#JOB_STALE_AFTER_SECONDS=300
#JOB_MAX_ATTEMPTS=3
#JOB_RETENTION_DAYS=7
#HUNT_RETENTION_DAYS=90
#AGENT_MAX_STEPS=200
#AGENT_UNIT_TIMEOUT_SECONDS=900

# SITE CIRCUIT BREAKER (all optional). A marketplace that starts answering
# challenge pages fails every read, and under a daemon that is every listing,
# every interval, forever. ERRORS consecutive failures stop the site outright
# for MINUTES; a wall that persists doubles the wait up to CAP_MINUTES, and
# any successful read resets the count. Lift a pause by hand from the Sites
# page, or with PATCH /api/sites/{id} {"paused_until": null}.
#SITE_BREAKER_ERRORS=5
#SITE_BREAKER_MINUTES=60
#SITE_BREAKER_CAP_MINUTES=1440

# DETERMINISTIC RECHECKS (all optional). The first time the model confirms a
# listing's price, code records WHERE on that page the price was — a JSON-LD
# path, a meta key, or a CSS selector — and every later recheck replays it
# with no model in the loop. When the same locator also works against the raw
# HTML, that listing's rechecks become a plain HTTP GET with no browser.
#   CHEAP_RECHECK=false     every recheck goes back through the LLM, as before
#   STATIC_FETCH=false      always open a browser; never the browserless GET
#   LOCATOR_MAX_FAILURES    misses before a locator is dropped and relearned
#CHEAP_RECHECK=true
#STATIC_FETCH=true
#LOCATOR_MAX_FAILURES=3

# PRICE PLAUSIBILITY. A reading outside these bands is recorded but not
# believed: it never notifies and never enters a chart or an average until a
# second reading agrees with it, so a page (or a mis-read) that says "$4.49"
# for a $449 item cannot wake a buying bot. LOW/HIGH bound the ratio against
# the listing's own last believed price; MARKET_FLOOR bounds it against the
# item's market median for the condition the watch wants. Set any to 0 to
# switch that band off.
#PRICE_BAND_LOW=0.2
#PRICE_BAND_HIGH=5
#PRICE_MARKET_FLOOR=0.1
