# AI provider config (used by config.py -> init_chat_model)
# Provider must match a langchain init_chat_model provider key,
# e.g. openrouter, openai, anthropic, ollama, groq, mistralai, etc.
AI_PROVIDER="openrouter"
AI_API_KEY="your-api-key-here"
AI_MODEL="minimax/minimax-m3"
AI_URL="https://openrouter.ai/api/v1"



#Monitoring

#If using langfuse
LANGFUSE_SECRET_KEY="your-secret-key-here"
LANGFUSE_PUBLIC_KEY="your-public-key-here"
LANGFUSE_BASE_URL="YOUR-URL-HERE"

#If using langsmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY="your-api-key-here"
LANGSMITH_PROJECT="your-project-name"
# MCP — a containerized agent needs a container-reachable host here
# (e.g. the MCP container's name on a shared docker network), not localhost.
PLAYWRIGHT_MCP_URL="http://localhost:8931/mcp"

# Visual authenticity: the vision sidecar's URL. Unset = the feature is off
# (the check_images tool is not registered; scraping runs exactly as before).
#VISION_SIDECAR_URL="http://localhost:8100"
#VISION_TIMEOUT_SECONDS=90

# DATABASE
DATABASE_URL="postgresql+asyncpg://user:password@host:5432/dbname"

# SEARCH (market-price grounding)
SEAR_XNG_URL="http://localhost:8888"
# The only currency grounding stats are built from (USD, EUR, GBP).
# Other currencies are recorded but never mixed in - no conversion.
EXPECTED_CURRENCY="USD"
# Market stats refresh when older than the TTL, at most MAX_REFRESH items per
# run (never-grounded items are exempt from the cap). Suggested crontab:
#   0 0 * * *    main.py                # nightly scrape (grounds as pre-pass)
#   * * * * *    main.py --consume      # claim runs + fire due schedules
#   */15 * * * * main.py --ground-only  # near-instant grounding for new items
# The docker-compose `agent` service is the packaged alternative to the
# --consume/--ground-only lines: a loop that checks the queue every minute.
MARKET_PRICE_TTL_HOURS=24
MARKET_PRICE_MAX_REFRESH_PER_RUN=10
