# AI provider config (used by config.py -> init_chat_model)
# Provider must match a langchain init_chat_model provider key,
# e.g. openrouter, openai, anthropic, ollama, groq, mistralai, etc.
AI_PROVIDER="openrouter"
AI_API_KEY="your-api-key-here"
AI_MODEL="minimax/minimax-m3"
AI_URL="https://openrouter.ai/api/v1"



#Monitoring

#If using langfuse
LANGFUSE_SECRET_KEY="your-secret-key-here"
LANGFUSE_PUBLIC_KEY="your-public-key-here"
LANGFUSE_BASE_URL="YOUR-URL-HERE"

#If using langsmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY="your-api-key-here"
LANGSMITH_PROJECT="your-project-name"
# MCP
PLAYWRIGHT_MCP_URL="http://localhost:port/mcp"

# DATABASE
DATABASE_URL="postgresql+asyncpg://user:password@host:5432/dbname"
